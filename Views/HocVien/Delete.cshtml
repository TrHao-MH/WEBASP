@model Lylich
@{
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<h3 color="red">Xóa học viên</h3>
<h3>Thông tin học viên</h3>
<a class="btn btn-primary" asp-action="Index">Trở về</a>
<dl class="row">
	<dt class="col-2">Mã học viên: </dt>
	<dt class="col-20">@Model.Mshv </dt>
	<dt class="col-2">Tên học viên: </dt>
	<dt class="col-20">@Model.Tenhv </dt>
	<dt class="col-2">Ngày sinh: </dt>
	<dt class="col-20">@(Model.Ngaysinh.Value.ToShortDateString()) </dt>
	<dt class="col-2">Phái: </dt>
	<dt class="col-20">@(Model.Phai.Value?"Nam":"Nữ") </dt>
	<dt class="col-2">Mã lớp: </dt>
	<dt class="col-20">@Model.Malop </dt>
	<form asp-action="aDelete" method="post" asp-route-id="@Model.Mshv">
		<div class="mb-3">
			<button type="submit" class="btn btn-danger">Xóa</button>
		</div>
		<div class="mb-3 text-bg-danger" asp-validation-summary="ModelOnly"> </div>
	</form>
</dl>
